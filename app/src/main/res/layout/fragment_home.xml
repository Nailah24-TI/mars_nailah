<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FC"
    tools:context=".Home.HomeFragment">

    <!-- Header Background -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:title="HOME"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Welcome -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/bitcountink_variable"
        android:text="Halo, Nailah! 👋"
        android:textColor="#4527A0"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="Selamat datang! Pilih materi praktikum yang ingin kamu pelajari."
        android:textColor="#666477"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Section Title -->
    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="25dp"
        android:text="Daftar Pertemuan"
        android:textColor="#29243D"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GridLayout: 3 Kolom -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridLayoutPertemuan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:padding="4dp"
        app:columnCount="3"
        app:rowCount="3"
        app:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pertemuan 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToSecond"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:minWidth="0dp"
            android:text="Pertemuan 2"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:backgroundTint="#673AB7"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Pertemuan 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToThird"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:minWidth="0dp"
            android:text="Pertemuan 3"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:backgroundTint="#673AB7"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Pertemuan 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToFourth"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:minWidth="0dp"
            android:text="Pertemuan 4"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:backgroundTint="#673AB7"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Pertemuan 5 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToFifth"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:minWidth="0dp"
            android:text="Pertemuan 5"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:backgroundTint="#673AB7"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Pertemuan 6 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToSixth"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:minWidth="0dp"
            android:text="Pertemuan 6"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:backgroundTint="#673AB7"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Pertemuan 9 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPertemuan9"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:minWidth="0dp"
            android:text="Pertemuan 9"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:backgroundTint="#673AB7"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Pertemuan 10 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPertemuan10"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:minWidth="0dp"
            android:text="Pertemuan 10"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:backgroundTint="#512DA8"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

    </androidx.gridlayout.widget.GridLayout>

    <!-- Logout -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="18dp"
        android:text="Logout"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="12dp"
        app:backgroundTint="#D32F2F"
        app:elevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/gridLayoutPertemuan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
