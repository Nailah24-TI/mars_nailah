<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FC"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".Home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header Background -->
        <View
            android:id="@+id/background_header"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:background="@drawable/bg_header_wave"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:title="HOME"
            app:titleTextColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Welcome -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/bitcountink_variable"
            android:text="Halo, Nailah! 👋"
            android:textColor="#4527A0"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="6dp"
            android:text="Selamat datang! Pilih materi praktikum yang ingin kamu pelajari."
            android:textColor="#666477"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Section Title -->
        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="24dp"
            android:text="Daftar Pertemuan"
            android:textColor="#29243D"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Grid Pertemuan -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridLayoutPertemuan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            android:padding="4dp"
            app:columnCount="3"
            app:rowCount="3"
            app:useDefaultMargins="true"
            app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToSecond"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:minWidth="0dp"
                android:text="Pertemuan 2"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:backgroundTint="#673AB7"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToThird"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:minWidth="0dp"
                android:text="Pertemuan 3"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:backgroundTint="#673AB7"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToFourth"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:minWidth="0dp"
                android:text="Pertemuan 4"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:backgroundTint="#673AB7"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToFifth"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:minWidth="0dp"
                android:text="Pertemuan 5"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:backgroundTint="#673AB7"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToSixth"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:minWidth="0dp"
                android:text="Pertemuan 6"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:backgroundTint="#673AB7"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan9"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:minWidth="0dp"
                android:text="Pertemuan 9"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:backgroundTint="#673AB7"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan10"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:minWidth="0dp"
                android:text="Pertemuan 10"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:backgroundTint="#512DA8"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

        </androidx.gridlayout.widget.GridLayout>

        <!-- Cat Fact -->
        <TextView
            android:id="@+id/tvCatFact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="20dp"
            android:padding="14dp"
            android:background="@drawable/edit_text_background"
            android:gravity="center"
            android:text="Loading cat fact..."
            android:textAlignment="center"
            android:textColor="#29243D"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/gridLayoutPertemuan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Refresh Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:text="Refresh Cat Fact"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:backgroundTint="#673AB7"
            app:layout_constraintTop_toBottomOf="@id/tvCatFact"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Gallery Title -->

        <!-- Gallery RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGallery"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@+id/btnRefresh"/>

        <!-- Logout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:text="Logout"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            app:backgroundTint="#D32F2F"
            app:layout_constraintTop_toBottomOf="@id/rvGallery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
